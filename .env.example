# Notion Integration Configuration (Place your actual keys in .env.local)
NOTION_API_KEY=""
NOTION_STUDENTS_DATABASE_ID=""
NOTION_FEE_RECORDS_DATABASE_ID=""
NOTION_PAYMENTS_DATABASE_ID=""

# Authentication Secret (Generate using: openssl rand -base64 32)
AUTH_SECRET=""

# App Environment & Base URL
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: PostgreSQL (if dual adapter or Prisma sync is used)
DATABASE_URL="postgresql://username:password@localhost:5432/fees_hisab?schema=public"
