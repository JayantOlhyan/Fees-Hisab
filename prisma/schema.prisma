datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model for Single Teacher Authentication
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  salutation   String   @default("Ma'am")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
