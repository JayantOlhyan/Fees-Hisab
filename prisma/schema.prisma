datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User / Teacher Account
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  salutation   String    @default("Ma'am")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  students     Student[]

  @@map("users")
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum FeeStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

// Student Entity
model Student {
  id           String        @id @default(uuid())
  userId       String
  name         String
  guardianName String?
  phone        String?
  className    String
  school       String?
  subjects     String[]
  joiningDate  DateTime      @db.Date
  monthlyFee   Decimal       @db.Decimal(10, 2)
  feeDueDay    Int           // 1 to 31
  status       StudentStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeRecords   FeeRecord[]
  payments     Payment[]

  @@index([userId])
  @@index([status])
  @@map("students")
}

// Monthly Fee Record Entity
model FeeRecord {
  id           String      @id @default(uuid())
  studentId    String
  billingYear  Int
  billingMonth Int         // 1 to 12
  amountDue    Decimal     @db.Decimal(10, 2)
  dueDate      DateTime    @db.Date
  status       FeeStatus   @default(UPCOMING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([studentId, billingYear, billingMonth], name: "student_billing_period_unique")
  @@index([studentId])
  @@index([status])
  @@map("fee_records")
}

// Payment Transaction Entity
model Payment {
  id            String        @id @default(uuid())
  studentId     String
  feeRecordId   String
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  paymentMethod PaymentMethod
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeRecord     FeeRecord     @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([feeRecordId])
  @@map("payments")
}
